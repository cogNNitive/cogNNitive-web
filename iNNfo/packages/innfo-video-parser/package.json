{
  "name": "@cognnitive/innfo-video-parser",
  "version": "0.1.0",
  "description": "VUS (video script) parser, semantic validator and pinned VUS spec for cogNNitive video scripts",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "specs"
  ],
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "build:grammar": "peggy --format es --output src/parser/vus_parser.js src/parser/vus.peggy",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "fast-check": "^4.7.0",
    "peggy": "^5.1.0",
    "tsx": "^4.22.0",
    "typescript": "^5.9.3",
    "vitest": "^1.6.0"
  }
}
